# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Application Security
SECRET_KEY=generate-a-strong-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Email SMTP Delivery (Gmail SMTP SSL)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-16-char-app-password
MAIL_FROM=your-email@gmail.com

# Real-Time Calling (ZegoCloud - Optional if using pure WebRTC)
ZEGO_APP_ID=123456789
ZEGO_SERVER_SECRET=your-zego-server-secret

# Firebase Admin SDK (FCM Push Notifications - JSON string or path)
FIREBASE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "your-project-id"}'
